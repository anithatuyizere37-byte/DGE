# Neon PostgreSQL Database Connection String (Serverless/Pooled)
DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD@YOUR_HOST-pooler.c-7.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require
PGHOST=YOUR_HOST-pooler.c-7.us-east-2.aws.neon.tech
PGDATABASE=neondb
PGUSER=neondb_owner
PGPASSWORD=YOUR_PASSWORD
PGSSLMODE=require

# Application Server Port & Security
PORT=5000
JWT_SECRET=your_super_secret_jwt_key_here
