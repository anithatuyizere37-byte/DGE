# Neon PostgreSQL Database Connection String (Serverless/Pooled)
DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD@ep-summer-field-b5uloa68-pooler.c-7.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require
PGHOST=ep-summer-field-b5uloa68-pooler.c-7.us-east-2.aws.neon.tech
PGDATABASE=neondb
PGUSER=neondb_owner
PGPASSWORD=YOUR_PASSWORD
PGSSLMODE=require

# Application Settings
PORT=5000
NODE_ENV=development
JWT_SECRET=your_jwt_signing_secret_minimum_32_chars_here
JWT_EXPIRES_IN=7d

# CORS — comma-separated allowed origins (omit for development wildcard)
# ALLOWED_ORIGINS=https://your-app.onrender.com,http://localhost:3000
